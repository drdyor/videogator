# VideoGator Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED: Authentication & Database
# ===========================================

# Database connection (PostgreSQL/MySQL)
DATABASE_URL=postgresql://user:password@localhost:5432/videogator

# OAuth server for authentication
OAUTH_SERVER_URL=https://your-oauth-server.com

# JWT secret for session cookies (generate a random 32+ char string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Owner's OpenID (gives admin access)
OWNER_OPEN_ID=your-openid-here

# App ID for Manus integration
VITE_APP_ID=your-app-id

# ===========================================
# REQUIRED: Redis for Job Queue
# ===========================================

# Redis connection for BullMQ job processing
REDIS_URL=redis://localhost:6379

# ===========================================
# VIDEO GENERATION: Local GPU Server
# ===========================================

# Your Windows GPU machine IP address
# This is where the video server runs
VIDEO_SERVER_URL=http://192.168.1.100:8001

# Default video model to use
# Options: hunyuan-video, mochi, cogvideo, modelscope, stable-video-diffusion
DEFAULT_VIDEO_MODEL=hunyuan-video

# ===========================================
# OPTIONAL: Cloud Video Generation (Fallback)
# ===========================================

# FFmpeg server for video editing
FFMPEG_SERVER_URL=

# ComfyUI server (alternative to local GPU)
COMFYUI_URL=

# ===========================================
# STORAGE: Cloudflare R2 (for video storage)
# ===========================================

# R2 endpoint URL
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# R2 credentials
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key

# R2 bucket name
R2_BUCKET=videogator-videos

# R2 public URL (for serving videos)
R2_PUBLIC_URL=https://pub-your-hash.r2.dev

# ===========================================
# OPTIONAL: Alerts & Notifications
# ===========================================

# Discord webhook for alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Telegram bot for alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===========================================
# OPTIONAL: LLM Integration (for prompt enhancement)
# ===========================================

# Forge API for LLM features
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ===========================================
# OPTIONAL: Paywall & Monetization
# ===========================================

# Stripe keys for payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Pricing (in cents)
PAYWALL_PRICE_CENTS=999
PAYWALL_CREDITS_INCLUDED=100

# ===========================================
# DEVELOPMENT ONLY
# ===========================================

# Node environment
NODE_ENV=development

# Port for dev server
PORT=3000
